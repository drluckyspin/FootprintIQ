SQFT_DATA_DIR=../data

# Optional: enable Mapbox satellite basemap (free Esri World Imagery used otherwise)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: pin which pipeline run the viz reads from. If unset, the latest run is used.
SQFT_PIPELINE_RUN_ID=

# QA review writer
SQFT_QA_REVIEWS_PATH=../data/output/qa_reviews.parquet
