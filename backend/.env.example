# --- Geocoding providers ---
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ADDRESS_VALIDATION_API_KEY=

# Optional fallback
CENSUS_GEOCODER_BENCHMARK=Public_AR_Current

# --- Cost guardrails ---
SQFT_MAX_COST_USD=50
SQFT_REQUIRE_CONFIRM_ABOVE_USD=50

# --- Overture ---
SQFT_OVERTURE_RELEASE=latest
SQFT_OVERTURE_S3_REGION=us-west-2

# --- Pipeline ---
SQFT_DATA_DIR=../data
SQFT_CONFIG_PATH=../config.yaml
SQFT_PIPELINE_RESUME=true

# --- Logging ---
SQFT_LOG_LEVEL=INFO
