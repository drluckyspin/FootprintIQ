# roof-survey root .env (committed as .env.example; gitignored as .env)
#
# Project-wide settings. Backend- and frontend-specific keys live in
# backend/.env.example and frontend/.env.example respectively.

# Environment label (local | cloud) — informational, not consumed by the pipeline directly
ENVIRONMENT="local"

# Shared data directory mounted into both backend (Python) and frontend (Next.js).
# All pipeline parquet outputs land under this directory.
SQFT_DATA_DIR="./data"

# Pipeline-wide log level (DEBUG | INFO | WARNING | ERROR)
SQFT_LOG_LEVEL="INFO"
