# FootprintIQ root .env — the only env file for this project.
# Copy to .env (or run `make check`). Docker Compose loads this via env_file: .env on every service.
# Local make targets source this file through scripts/loadenv.bash — do not create backend/.env or frontend/.env.

# --- Environment ---
ENVIRONMENT="local"

# Shared data directory (pipeline parquet + visualizer reads from here)
SQFT_DATA_DIR="./data"

# Pipeline + visualizer log level (DEBUG | INFO | WARNING | ERROR)
# Use DEBUG to see each pipeline stage, Google/Overture API calls, and DuckDB paths.
SQFT_LOG_LEVEL="DEBUG"

# --- Google Maps Platform (required for live runs; not needed for `make demo`) ---
# Geocoding API: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
GOOGLE_GEOCODING_API_KEY="your-geocoding-api-key"
# Places API (Text Search + Details): https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY="your-places-api-key"
# Optional — reserved for future address validation (uncomment when wired):
# GOOGLE_ADDRESS_VALIDATION_API_KEY="your-address-validation-api-key"

# --- Optional geocoder fallback ---
CENSUS_GEOCODER_BENCHMARK="Public_AR_Current"

# --- Pipeline overrides (optional; defaults live in config.yaml) ---
SQFT_PIPELINE__RESUME="true"
SQFT_PIPELINE__MAX_COST_USD="50"
SQFT_PIPELINE__REQUIRE_CONFIRM_ABOVE_USD="50"
SQFT_OVERTURE__RELEASE="latest"

# --- Frontend visualizer (optional) ---
# Esri World Imagery is used when unset; set only if you switch the basemap to Mapbox
# NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"
# Pin a specific pipeline run; uncomment to override latest output
# SQFT_PIPELINE_RUN_ID="20260521T030500Z__abcd1234"
